# TESSERA — Environment Variables
#
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env or any file containing real credentials.
# All values here are PLACEHOLDERS only.
#
# ─────────────────────────────────────────────────────────────────────

# ── Node.js / Express API ────────────────────────────────────────────
NODE_ENV=development
API_PORT=3000

# ── Hyperledger Fabric Gateway ───────────────────────────────────────
FABRIC_CHANNEL_NAME=mychannel
FABRIC_CHAINCODE_NAME=asset-contract
FABRIC_MSP_ID=Org1MSP
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_TLS_CERT_PATH=/path/to/tls/cert.pem
FABRIC_GATEWAY_PEER_HOST_ALIAS=peer0.org1.example.com

# ── Fabric CA / Identity ─────────────────────────────────────────────
FABRIC_CA_URL=https://localhost:7054
FABRIC_CA_TLS_CERT_PATH=/path/to/ca/tls-cert.pem
FABRIC_ADMIN_IDENTITY_PATH=/path/to/admin/identity
FABRIC_WALLET_PATH=/path/to/wallet

# ── MinIO (Off-Chain Evidence Storage) ───────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=PLACEHOLDER_ACCESS_KEY
MINIO_SECRET_KEY=PLACEHOLDER_SECRET_KEY
MINIO_BUCKET_EVIDENCE=tessera-evidence

# ── JWT / API Authentication ─────────────────────────────────────────
# Secret used to sign API session tokens (if applicable).
# Must be a long random string in production.
API_JWT_SECRET=92e7f24aef75b8118a1696a448455e335a5b1dec3c67bce04caf06c2fd04ffa8
API_JWT_EXPIRES_IN=1h

# ── CORS ─────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── External Adapters ────────────────────────────────────────────────
GOVERNMENT_REGISTRY_API_URL=https://placeholder.gov/api
GOVERNMENT_REGISTRY_API_KEY=PLACEHOLDER_KEY

VALUATION_SERVICE_API_URL=https://placeholder-valuation.example.com/api
VALUATION_SERVICE_API_KEY=PLACEHOLDER_KEY

INSURANCE_SERVICE_API_URL=https://placeholder-insurance.example.com/api
INSURANCE_SERVICE_API_KEY=PLACEHOLDER_KEY

INSPECTION_SERVICE_API_URL=https://placeholder-inspection.example.com/api
INSPECTION_SERVICE_API_KEY=PLACEHOLDER_KEY

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────────
# NOTE: Do not add real credentials, private keys, or certificates here.
# ─────────────────────────────────────────────────────────────────────
